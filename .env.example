# ---------------------------------------------------------------------------
# CareerMatch AI — environment template. Copy to .env and fill in values.
# Never commit your real .env file.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
APP_ENV=development

# REQUIRED in production: a long random string used to sign access tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL recommended; SQLite works for local experiments/tests)
POSTGRES_USER=careermatch
POSTGRES_PASSWORD=careermatch
POSTGRES_DB=careermatch
DATABASE_URL=postgresql+psycopg://careermatch:careermatch@localhost:5432/careermatch

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173

# Resume uploads
MAX_UPLOAD_MB=5
STORAGE_DIR=./storage
# Keep the original uploaded file after parsing? (false = parse then discard)
RETAIN_RESUME_FILES=false

# ---------------------------------------------------------------------------
# Job providers (public, unauthenticated job-board APIs)
# ---------------------------------------------------------------------------
# Greenhouse board tokens, e.g. the "acme" in boards.greenhouse.io/acme
GREENHOUSE_BOARDS=
# Lever site names, e.g. the "acme" in jobs.lever.co/acme
LEVER_SITES=
# global | eu
LEVER_REGION=global
PROVIDER_TIMEOUT_SECONDS=15
# Minimum minutes between manual refreshes of the same source
REFRESH_COOLDOWN_MINUTES=10
# Listings not re-checked within this many days are flagged as stale
LISTING_STALE_DAYS=7

# Clearly labelled fictional listings so the workflow can be demonstrated
# offline. Disabled automatically when APP_ENV=production.
ENABLE_DEMO_PROVIDER=true

# ---------------------------------------------------------------------------
# Semantic matching
# ---------------------------------------------------------------------------
# auto | sentence-transformers | lsa
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Optional LLM for the career assistant (the app works without it)
# ---------------------------------------------------------------------------
# none | anthropic
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# Frontend (Vite) — base URL of the API
VITE_API_BASE_URL=http://localhost:8000
