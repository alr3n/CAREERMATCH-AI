# ---------------------------------------------------------------------------
# CareerMatch AI — environment template. Copy to .env and fill in values.
# Never commit your real .env file.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
APP_ENV=development

# REQUIRED in production: a long random string used to sign access tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL recommended; SQLite works for local experiments/tests)
POSTGRES_USER=careermatch
POSTGRES_PASSWORD=careermatch
POSTGRES_DB=careermatch
DATABASE_URL=postgresql+psycopg://careermatch:careermatch@localhost:5432/careermatch

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173

# Resume uploads
MAX_UPLOAD_MB=5
STORAGE_DIR=./storage
# Keep the original uploaded file after parsing? (false = parse then discard)
RETAIN_RESUME_FILES=false

# ---------------------------------------------------------------------------
# Job sources — real listings only (see docs/EXTERNAL_INTEGRATIONS.md)
# ---------------------------------------------------------------------------
# Public employer job boards, no key needed. Entries are "identifier" or
# "identifier:Company Name". Defaults were verified to have Philippine openings.
# Greenhouse board tokens (boards.greenhouse.io/<token>)
GREENHOUSE_BOARDS=xendit:Xendit
# Lever site names (jobs.lever.co/<site>); Lever has no company field, so name it
LEVER_SITES=coins:Coins.ph,lalamove:Lalamove,ninjavan:Ninja Van,tala:Tala
# global | eu
LEVER_REGION=global
# SmartRecruiters company identifiers (jobs.smartrecruiters.com/<company>)
SMARTRECRUITERS_COMPANIES=Sutherland,DeliveryHero:Delivery Hero (foodpanda),Grab,BoschGroup:Bosch,Canva,HomeCredit:Home Credit
# Country filter applied by SmartRecruiters (ISO code, empty = all countries)
SMARTRECRUITERS_COUNTRY=ph
# Max postings per company whose full description is fetched (one request each)
SMARTRECRUITERS_MAX_DETAILS=100
# Remotive public remote-jobs feed (attribution required, <= ~4 fetches/day)
REMOTIVE_ENABLED=true
REMOTIVE_CATEGORY=

# JSearch — Google for Jobs aggregator: postings published on LinkedIn, Indeed,
# Glassdoor, JobStreet and employer sites. Requires a key from
# https://www.openwebninja.com/api/jsearch (or RapidAPI). Free plan: 200 req/month.
# Keep the key here (server-side) only — never in frontend variables.
JSEARCH_API_KEY=
# Semicolon-separated queries; each query costs one request per page per refresh
JSEARCH_QUERIES=software developer in Philippines;data analyst in Philippines;customer service in Philippines
JSEARCH_COUNTRY=ph
# all | today | 3days | week | month
JSEARCH_DATE_POSTED=month
JSEARCH_PAGES=1
JSEARCH_MIN_INTERVAL_MINUTES=720

# ph = keep only postings in the Philippines (or remote and open to it) from
# boards that list worldwide offices; none = keep everything
JOB_LOCATION_FILTER=ph
PROVIDER_TIMEOUT_SECONDS=15
# Minimum minutes between manual refreshes of the same source
REFRESH_COOLDOWN_MINUTES=10
# Background refresh inside the API (minutes, 0 = off; then use cron with
# `python -m app.cli refresh-jobs`). Provider minimum intervals always apply.
AUTO_REFRESH_MINUTES=360
# Listings not re-checked within this many days are flagged as stale
LISTING_STALE_DAYS=7

# ---------------------------------------------------------------------------
# Semantic matching
# ---------------------------------------------------------------------------
# auto | sentence-transformers | lsa
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Optional LLM for the career assistant (the app works without it)
# ---------------------------------------------------------------------------
# none | anthropic
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# Frontend (Vite) — base URL of the API
VITE_API_BASE_URL=http://localhost:8000
